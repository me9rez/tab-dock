{
  "manifest_version": 3,
  "name": "TabDock",
  "version": "1.1.0",
  "description": "标签页的码头：把标签页桥接给本地 agent（HTTP 读取/控制），GitHub 仓库可成批收藏、一键恢复或关闭。",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabDock",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
